# ================== Discord Bot Settings ==================
# DISCORD_TOKEN=your_discord_token_here
# GUILD_ID=your_guild_id_here

# ================== Web API Settings ==================
# Web API サーバー設定
WEB_HOST=0.0.0.0
WEB_PORT=8000

# API Security - リクエストに含める API キー
# 安全性のため、複雑なランダム文字列を使用してください
# 例：python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secret-api-key-change-this

# CORS設定 - GitHub Pages のURL（複数指定可能）
# 例：https://username.github.io
# 複数の場合はカンマ区切りで指定
CORS_ORIGIN_GITHUB_PAGES=https://username.github.io

# ================== Gmail Integration ==================
# GMAIL_CREDENTIALS=path/to/credentials.json

# ================== Logging ==================
LOG_LEVEL=INFO

# ================== Environment ==================
DEBUG=False
